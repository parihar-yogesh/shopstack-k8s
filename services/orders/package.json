{
  "name": "orders-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -t pgmigrations_orders",
    "migrate:test": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -t pgmigrations_orders -d TEST_DATABASE_URL",
    "pretest": "npm run migrate:test up",
    "test": "tsx --env-file-if-exists=../../.env --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "argon2": "0.45.1",
    "fastify": "5.12.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}